# Copy this file to .env.local and fill in your own local values.
# Do not commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated invite list. Use the same emails in both values.
# Example: friend@example.com,team@example.com
NEXT_PUBLIC_ALLOWED_EMAILS=
ALLOWED_EMAILS=

# Server-only Google Gemini API key.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override for outfit photo analysis.
GEMINI_ANALYSIS_MODEL=

# HTTPS origin of the deployed API, required for bundled iOS builds.
NEXT_PUBLIC_API_ORIGIN=

# Server only: required by account deletion. NEVER use a NEXT_PUBLIC prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Server only: distributed AI request quotas. Missing/unavailable Redis blocks AI.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Maximum admitted AI requests across all users per UTC day.
AI_GLOBAL_DAILY_LIMIT=1000
